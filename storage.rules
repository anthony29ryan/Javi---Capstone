rules_version = '2';

// Tested by tests/rules/storage.test.js — run `npm run test:rules` after any
// change here, then `npm run rules:deploy`.

service firebase.storage {
  match /b/{bucket}/o {
    // Lesson images are uploaded through the Firebase console, which bypasses
    // these rules, so the app only ever needs to read them.
    match /lessons/{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}
