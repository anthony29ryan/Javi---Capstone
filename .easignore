# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase CLI and emulator output
.firebase/
firebase-debug*.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log

# Service-account keys grant full admin access. Keep them outside the
# project entirely; this is only a backstop in case one lands here.
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json

# ---------------------------------------------------------------
# EAS-only exclusions.
# .easignore REPLACES .gitignore for EAS uploads, so everything
# above is copied from .gitignore and must stay in sync with it.
# ---------------------------------------------------------------

# Vendored agent skills. .claude/skills/* are symlinks into
# .agents/skills/*, and Windows refuses to recreate symlinks when
# EAS copies the project to a temp dir (EPERM). None of this is
# used by the Android build.
.agents/
.claude/
