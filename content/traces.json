    "title": "A generic box",
    "lines": [
      "class Box<T> {",
      "  private T item;",
      "  Box(T item) {",
      "    this.item = item;",
      "  }",
      "  T get() {",
      "    return item;",
      "  }",
      "}",
      "public class Main {",
      "  public static void main(String[] args) {",
      "    Box<String> box = new Box<>(\"Java\");",
      "    System.out.println(box.get().length());",
      "  }",
      "}"
    ]
  }
