rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may read and write only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // TEMPORARY: any signed-in user can read/write course content while we're
    // still seeding placeholder lessons via scripts/seedContent.js. Once real
    // content is in place, tighten this to read-only (no client write) since
    // content should only ever be authored via the seed script, not the app.
    match /courses/{courseId} {
      allow read, write: if request.auth != null;
    }
    match /modules/{moduleId} {
      allow read, write: if request.auth != null;
    }
    match /lessons/{lessonId} {
      allow read, write: if request.auth != null;
    }
    // Same TEMPORARY seeding rule for placeholder quiz questions.
    match /questions/{questionId} {
      allow read, write: if request.auth != null;
    }

    // A signed-in user may create attempt records for themselves, and read
    // only their own — never anyone else's, and never edit/delete history.
    match /attempts/{attemptId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Everything else stays default-deny until those collections get rules.
  }
}
