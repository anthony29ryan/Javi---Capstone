rules_version = '2';

// Tested by tests/rules/firestore.test.js — run `npm run test:rules` after any
// change here, then `npm run rules:deploy`. A rule that is too permissive
// still lets the app work, so only the tests will notice it.
//
// Admin access: the Firebase console and the scripts in scripts/ use admin
// credentials, which bypass these rules entirely. So "only the admin can do X"
// is written here as "nobody can do X", and it is not a missing feature.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // The fields this write adds, changes or removes compared with what is
    // stored. Checking only these, rather than the whole document, means an
    // account created by an older build that carries a field the app no longer
    // writes can still save everything else.
    function changedFields() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when this write sets `field` to a new value. Used as
    // `!changed('x') || <check on x>`: fields the write does not touch, or
    // removes, skip the check, and `||` stops before reading a missing field.
    function changed(field) {
      return field in changedFields() && field in request.resource.data;
    }

    // ---------------------------------------------------------------- content
    // Read-only for the app. Published by scripts/publishContent.js, which
    // uses the Admin SDK, and editable by hand in the Firebase console.

    match /courses/{courseId} {
      allow read: if signedIn();
    }
    match /modules/{moduleId} {
      allow read: if signedIn();
    }
    match /lessons/{lessonId} {
      allow read: if signedIn();
    }
    match /questions/{questionId} {
      allow read: if signedIn();
    }
    match /traces/{traceId} {
      allow read: if signedIn();
    }

    // ------------------------------------------------------------------ users
    // Profile and preferences. Written by AuthContext and services/preferences.

    function validUserWrite() {
      let data = request.resource.data;
      return changedFields().hasOnly([
          'email', 'displayName', 'lastName', 'nickname', 'avatar', 'createdAt',
          'reminderTime', 'reminderEnabled', 'goals', 'setupComplete', 'tourSeen',
          'deletionRequestedAt', 'termsAcceptedAt', 'termsVersion'
        ])
        && (!changed('email') || data.email is string)
        && (!changed('displayName')
            || (data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100))
        && (!changed('lastName')
            || (data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100))
        // Shown in greetings, so kept short enough for one line.
        && (!changed('nickname')
            || (data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 30))
        // One of the 12 avatars in src/constants/art.js.
        && (!changed('avatar')
            || data.avatar in ['m1', 'm2', 'm3', 'm4', 'm5', 'm6', 'w1', 'w2', 'w3', 'w4', 'w5', 'w6'])
        && (!changed('createdAt') || data.createdAt == request.time)
        && (!changed('reminderTime')
            || (data.reminderTime is string && data.reminderTime.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && (!changed('reminderEnabled') || data.reminderEnabled is bool)
        && (!changed('goals') || (data.goals is list && data.goals.size() <= 20))
        && (!changed('setupComplete') || data.setupComplete is bool)
        && (!changed('tourSeen') || data.tourSeen is bool)
        // Proof of consent from the sign-up Terms popup: the server's clock,
        // so the acceptance time cannot be backdated, and the text's version.
        && (!changed('termsAcceptedAt') || data.termsAcceptedAt == request.time)
        && (!changed('termsVersion')
            || (data.termsVersion is string && data.termsVersion.size() <= 20))
        // Starts the 30-day deletion window. It must be the server's clock, so
        // the window cannot be backdated to make the purge run early. Removing
        // the field (logging back in) is also allowed, since `changed` is false
        // once the field is gone.
        && (!changed('deletionRequestedAt') || data.deletionRequestedAt == request.time);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserWrite();
      // Deleting an account is scheduled, not immediate: the app sets
      // deletionRequestedAt and scripts/purgeDeletedAccounts.js removes the
      // data once 30 days pass. So the app never deletes this document.
    }

    // --------------------------------------------------------------- progress
    // Written by services/progress.js with merge, so each write carries only
    // some of these fields.

    function validProgressWrite() {
      let data = request.resource.data;
      return changedFields().hasOnly([
          'completedLessons', 'completedTraces', 'moduleScores', 'streak', 'lastLessonId', 'updatedAt'
        ])
        && (!changed('completedLessons')
            || (data.completedLessons is list && data.completedLessons.size() <= 1000))
        && (!changed('completedTraces')
            || (data.completedTraces is list && data.completedTraces.size() <= 1000))
        && (!changed('moduleScores') || data.moduleScores is map)
        && (!changed('streak')
            || (data.streak is map
                && data.streak.keys().hasOnly(['current', 'longest', 'lastActiveDate'])
                && data.streak.current is int
                && data.streak.longest is int
                && (data.streak.lastActiveDate == null || data.streak.lastActiveDate is string)))
        && (!changed('lastLessonId') || data.lastLessonId is string)
        && (!changed('updatedAt') || data.updatedAt == request.time);
    }

    match /progress/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validProgressWrite();
    }

    // --------------------------------------------------------------- attempts
    // One document per quiz answer. Only the gradeAnswer Cloud Function writes
    // them (admin access): it alone can see the answer key, so `correct` is
    // its verdict. This is the trained model's feature source, so the app
    // cannot create, edit or delete one — only read its own.

    match /attempts/{attemptId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------------------ chats
    // One tutor thread per user per module, written only by the askTutor Cloud
    // Function (admin access). The app can read its own and nothing else.
    // tutorUsage, which counts each user's daily questions, has no rule at all
    // and so stays closed to the app.

    // `resource == null` lets the app read its own thread before the first
    // question creates it; otherwise that read would be refused. It only
    // reveals that a thread does not exist, never anyone's messages.
    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Everything else is denied by default.
  }
}
