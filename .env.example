EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Used only by the admin scripts in scripts/ (content publishing, account purge),
# never by the app. Full path to a service-account key downloaded from Firebase
# console -> Project settings -> Service accounts -> Generate new private key.
# Keep the key file OUTSIDE this project folder: it grants full admin access.
GOOGLE_APPLICATION_CREDENTIALS=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RapidAPI key for Judge0 CE. Used only by scripts run on this machine, never by
# the app. The deployed runChallenge/runCode functions read the same value from
# the Firebase secret JUDGE0_KEY (functions:secrets:set JUDGE0_KEY --data-file <file>).
JUDGE0_KEY=
